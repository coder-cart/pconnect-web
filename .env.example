# Local development (API on port 7001, web on 7000)
NEXT_PUBLIC_API_URL="http://localhost:7001/api"
NEXT_PUBLIC_WS_URL="http://localhost:7001"

# --- Vercel production ---
# Set these in the Vercel project → Settings → Environment Variables.
# Use your Render (or other) API public URL — no trailing slash on the host.
#
# NEXT_PUBLIC_API_URL="https://pconnect-api.onrender.com/api"
# NEXT_PUBLIC_WS_URL="https://pconnect-api.onrender.com"
#
# On the API, set FRONTEND_URL to your Vercel URL (comma-separate preview URLs if needed):
# FRONTEND_URL="https://your-app.vercel.app,https://your-app-*.vercel.app"
#
# Stripe publishable key (safe to expose). Required for the card payment form;
# leave unset to show a manual-payment message instead.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Public only — never put secrets in NEXT_PUBLIC_* variables.
